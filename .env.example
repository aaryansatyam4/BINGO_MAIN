# --- Required -------------------------------------------------------------
# 32 random bytes as hex: `openssl rand -hex 32`. Encrypts every stored credential.
BINGO_MASTER_KEY=
# Owner sign-in password for the dashboard.
BINGO_OWNER_PASSWORD=
# Shared secret for the 24/7 scheduler (Vercel Cron sends it automatically).
CRON_SECRET=
# Postgres (Vercel Postgres / Neon / Supabase). Without it, local dev uses ./.data files.
DATABASE_URL=
# Public URL of this deployment (used for OAuth redirects and webhooks).
BINGO_PUBLIC_URL=https://your-bingo.vercel.app

# --- Optional (can also be entered in Settings) ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Vercel Integration (for the "Authorize Vercel" button); otherwise paste a token in Settings.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
TELEGRAM_BOT_TOKEN=
# Separate secret for session cookies (defaults to BINGO_MASTER_KEY).
BINGO_SESSION_SECRET=

# --- Development only -----------------------------------------------------
# Lets BINGO BUILD run generated code in a local temp directory (no network isolation).
# Never set this in production; production uses Vercel Sandbox.
BINGO_ALLOW_LOCAL_SANDBOX=0
